# Copy to .env.local for local development, and set the same variables in
# your hosting provider (e.g. Vercel → Settings → Environment Variables).
# Never commit real values.

# --- Supabase -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses row-level security — never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ------------------------------------------------------------------
# Public origin of the app, e.g. https://anza.example.com (no trailing slash).
# Used for links inside sign-up, password-reset and invitation emails/links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated emails allowed into /admin. Server only: do NOT prefix with
# NEXT_PUBLIC_. Without it nobody can open the admin portal.
ADMIN_EMAILS=

# --- AI providers (at least one; tried in this order) -----------------------
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Optional model overrides
# GEMINI_MODEL=
# GROQ_MODEL=
# DEEPSEEK_MODEL=
# OPENAI_MODEL=

# --- Exchange rates (optional) ----------------------------------------------
# Financial Planning converts currencies with live rates. The default source
# is https://open.er-api.com/v6/latest (no key needed, attribution shown in
# the app). Point this at another endpoint with the same response shape to
# change provider. When the service is unreachable the app says rates are
# unavailable; it never guesses.
# EXCHANGE_RATES_API_URL=
